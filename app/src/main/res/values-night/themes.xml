<resources>

    <!-- ══════════════════════════════════════════════════════════
         DARK THEME
    ══════════════════════════════════════════════════════════ -->
    <style name="Theme.VinayakaCableNetwork" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary (Blue) -->
        <item name="colorPrimary">@color/cm_blue</item>
        <item name="colorOnPrimary">#062A42</item>
        <item name="colorPrimaryContainer">#0B3C5D</item>
        <item name="colorOnPrimaryContainer">#E9EFF7</item>

        <!-- Secondary (Green) -->
        <item name="colorSecondary">@color/cm_teal</item>
        <item name="colorOnSecondary">#0B2A20</item>
        <item name="colorSecondaryContainer">#1C5C45</item>
        <item name="colorOnSecondaryContainer">#DCF3E8</item>

        <!-- Tertiary (Teal/Cyan accent) -->
        <item name="colorTertiary">@color/cm_amber</item>
        <item name="colorOnTertiary">#31230B</item>
        <item name="colorTertiaryContainer">#6B4E15</item>
        <item name="colorOnTertiaryContainer">#FCEFD9</item>

        <!-- Error (Red) -->
        <item name="colorError">@color/cm_coral</item>
        <item name="colorOnError">#320F18</item>
        <item name="colorErrorContainer">#6E2436</item>
        <item name="colorOnErrorContainer">#FBE4E8</item>

        <!-- Surface / Background -->
        <item name="colorSurface">@color/cm_card</item>
        <item name="colorOnSurface">@color/cm_text_primary</item>
        <item name="colorSurfaceVariant">@color/cm_card2</item>
        <item name="colorOnSurfaceVariant">@color/cm_text_secondary</item>
        <item name="android:colorBackground">@color/cm_bg</item>
        <item name="colorOnBackground">@color/cm_text_primary</item>

        <!-- Outline -->
        <item name="colorOutline">#708197</item>
        <item name="colorOutlineVariant">@color/cm_border</item>

    </style>

</resources>