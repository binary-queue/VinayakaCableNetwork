<resources>

    <!-- ══════════════════════════════════════════════════════════
         LIGHT THEME
    ══════════════════════════════════════════════════════════ -->
    <style name="Base.Theme.VinayakaCableNetwork" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary (Blue) -->
        <item name="colorPrimary">@color/cm_blue</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DFEDF6</item>
        <item name="colorOnPrimaryContainer">#062A42</item>

        <!-- Secondary (Green) -->
        <item name="colorSecondary">@color/cm_teal</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#DCF3E8</item>
        <item name="colorOnSecondaryContainer">#0B2A20</item>

        <!-- Tertiary (Teal/Cyan accent) -->
        <item name="colorTertiary">@color/cm_amber</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#FCEFD9</item>
        <item name="colorOnTertiaryContainer">#31230B</item>

        <!-- Error (Red) -->
        <item name="colorError">@color/cm_coral</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#FBE4E8</item>
        <item name="colorOnErrorContainer">#320F18</item>

        <!-- Surface / Background -->
        <item name="colorSurface">@color/cm_card</item>
        <item name="colorOnSurface">@color/cm_text_primary</item>
        <item name="colorSurfaceVariant">@color/cm_card2</item>
        <item name="colorOnSurfaceVariant">@color/cm_text_secondary</item>
        <item name="android:colorBackground">@color/cm_bg</item>
        <item name="colorOnBackground">@color/cm_text_primary</item>

        <!-- Outline -->
        <item name="colorOutline">#8494A8</item>
        <item name="colorOutlineVariant">@color/cm_border</item>

    </style>

</resources>