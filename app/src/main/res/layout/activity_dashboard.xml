<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cm_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ══ TOPBAR ══ -->
        <LinearLayout
            android:id="@+id/dashboardTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@color/cm_sidebar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="11dp"
            android:elevation="2dp">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/cm_gradient_blue_logo">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_satellite_dish"
                    app:tint="@color/cm_on_gradient" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/cm_on_gradient"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin · Sai Cable Network"
                    android:textColor="@color/cm_nav_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/cm_gradient_blue">

                <TextView
                    android:id="@+id/tvProfileInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="A"
                    android:textColor="@color/cm_on_gradient"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Month filter chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="13dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipThisMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/filter_this_month"
                            android:textColor="@color/cm_blue"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/cm_bg_input"
                            android:paddingHorizontal="13dp"
                            android:paddingVertical="7dp"
                            android:layout_marginEnd="7dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipLastMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/filter_last_month"
                            android:textColor="@color/cm_text_secondary"
                            android:textSize="11.5sp"
                            android:background="@drawable/cm_bg_card"
                            android:paddingHorizontal="13dp"
                            android:paddingVertical="7dp"
                            android:layout_marginEnd="7dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipCustomRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/filter_custom_range"
                            android:textColor="@color/cm_text_secondary"
                            android:textSize="11.5sp"
                            android:background="@drawable/cm_bg_card"
                            android:paddingHorizontal="13dp"
                            android:paddingVertical="7dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="9dp">
                    <LinearLayout
                        android:id="@+id/statActive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/cm_bg_card"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/tvActiveCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/cm_teal"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/active_label"
                            android:textColor="@color/cm_text_tertiary"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/statInactive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/cm_bg_card"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/tvInactiveCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/cm_coral"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cut_inactive"
                            android:textColor="@color/cm_text_tertiary"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2x2 stat grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="9dp">

                    <LinearLayout
                        android:id="@+id/statTotal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:background="@drawable/cm_bg_card"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="33dp"
                            android:layout_height="33dp"
                            android:gravity="center"
                            android:text="👥"
                            android:textSize="15sp"
                            android:background="@drawable/cm_bg_soft_blue"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvTotalCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/cm_blue"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_customers"
                            android:textColor="@color/cm_text_tertiary"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/statPaid"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical"
                        android:background="@drawable/cm_bg_card"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="33dp"
                            android:layout_height="33dp"
                            android:gravity="center"
                            android:text="✅"
                            android:textSize="15sp"
                            android:background="@drawable/cm_bg_soft_teal"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvPaidCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/cm_teal"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/paid_this_month"
                            android:textColor="@color/cm_text_tertiary"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="13dp">

                    <LinearLayout
                        android:id="@+id/statUnpaid"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical"
                        android:background="@drawable/cm_bg_card"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="33dp"
                            android:layout_height="33dp"
                            android:gravity="center"
                            android:text="❌"
                            android:textSize="15sp"
                            android:background="@drawable/cm_bg_soft_coral"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvUnpaidCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/cm_coral"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/unpaid_this_month"
                            android:textColor="@color/cm_text_tertiary"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/statPartial"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:orientation="vertical"
                        android:background="@drawable/cm_bg_card"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="33dp"
                            android:layout_height="33dp"
                            android:gravity="center"
                            android:text="⚡"
                            android:textSize="15sp"
                            android:background="@drawable/cm_bg_soft_amber"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvPartialCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/cm_amber"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/partially_paid"
                            android:textColor="@color/cm_text_tertiary"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ══ ADMIN-ONLY FINANCE SECTION ══ -->
                <LinearLayout
                    android:id="@+id/adminFinSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/cm_bg_card"
                        android:padding="13dp"
                        android:layout_marginBottom="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/this_month_billing_label"
                            android:textColor="@color/cm_text_tertiary"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tvMonthBilling"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0"
                            android:textColor="@color/cm_blue"
                            android:textSize="21sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/cm_bg_hero"
                        android:padding="16dp"
                        android:layout_marginBottom="9dp">

                        <TextView
                            android:id="@+id/tvCollectionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏦  This Month Collection"
                            android:textColor="@color/cm_nav_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvMonthCollection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0"
                            android:textColor="@color/cm_on_gradient"
                            android:textSize="30sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:id="@+id/statTodayCollection"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:orientation="vertical"
                            android:background="@drawable/cm_bg_card"
                            android:padding="13dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/todays_collection_label"
                                android:textColor="@color/cm_text_tertiary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTodayAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0"
                                android:textColor="@color/cm_sky"
                                android:textSize="17sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/statOutstanding"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:orientation="vertical"
                            android:background="@drawable/cm_bg_card"
                            android:padding="13dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_outstanding_label"
                                android:textColor="@color/cm_text_tertiary"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvTotalOutstanding"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0"
                                android:textColor="@color/cm_coral"
                                android:textSize="17sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Collection progress -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/cm_bg_card"
                        android:padding="13dp"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/collection_progress_label"
                                android:textColor="@color/cm_text_primary"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvProgressPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="@color/cm_teal"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="7dp"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:background="@color/cm_border">

                            <View
                                android:id="@+id/progressFill"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0"
                                android:background="@drawable/cm_gradient_teal" />

                            <View
                                android:id="@+id/progressRemainder"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="100" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 6-month trend (illustrative — real historical aggregation is a Reports-feature addition) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/cm_bg_card"
                        android:padding="13dp"
                        android:layout_marginBottom="13dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/six_month_trend_label"
                            android:textColor="@color/cm_text_primary"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="9dp" />

                        <LinearLayout
                            android:id="@+id/sixMonthBars"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:orientation="horizontal"
                            android:gravity="bottom"
                            android:weightSum="6" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ══ EMPLOYEE-ONLY SECTION ══ -->
                <LinearLayout
                    android:id="@+id/employeeFinSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/cm_bg_card"
                    android:padding="13dp"
                    android:layout_marginBottom="13dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_todays_collection_label"
                        android:textColor="@color/cm_text_tertiary"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/tvEmployeeToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0"
                        android:textColor="@color/cm_teal"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/employee_month_collection"
                        android:textColor="@color/cm_text_tertiary"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/tvEmployeeMonthCollection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0"
                        android:textColor="@color/cm_teal"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressEmployeeMonth"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/cm_teal"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRecentPaymentsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/recent_payments"
                    android:textColor="@color/cm_text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNoRecentPayments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/no_recent_payments"
                    android:textColor="@color/cm_text_tertiary"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/recentPaymentsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="13dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_actions"
                    android:textColor="@color/cm_text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="9dp" />

                <!-- Quick actions 3x2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="9dp">

                    <LinearLayout android:id="@+id/qaPayment" style="@style/QuickActionCell">
                        <TextView style="@style/QuickActionIcon" android:text="💳" android:background="@drawable/cm_bg_soft_blue" />
                        <TextView style="@style/QuickActionLabel" android:text="@string/make_payment_label" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/qaAddCustomer" style="@style/QuickActionCell">
                        <TextView style="@style/QuickActionIcon" android:text="➕" android:background="@drawable/cm_bg_soft_teal" />
                        <TextView style="@style/QuickActionLabel" android:text="@string/add_customer_label" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/qaPaid" style="@style/QuickActionCell" android:layout_marginEnd="0dp">
                        <TextView style="@style/QuickActionIcon" android:text="✅" android:background="@drawable/cm_bg_soft_teal" />
                        <TextView style="@style/QuickActionLabel" android:text="@string/paid_label" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/qaUnpaid" style="@style/QuickActionCell">
                        <TextView style="@style/QuickActionIcon" android:text="❌" android:background="@drawable/cm_bg_soft_coral" />
                        <TextView style="@style/QuickActionLabel" android:text="@string/unpaid_label" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/qaReport" style="@style/QuickActionCell">
                        <TextView style="@style/QuickActionIcon" android:text="📊" android:background="@drawable/cm_bg_soft_sky" />
                        <TextView style="@style/QuickActionLabel" android:text="@string/action_report" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/qaGenerateBills" style="@style/QuickActionCell" android:layout_marginEnd="0dp">
                        <TextView style="@style/QuickActionIcon" android:text="🧾" android:background="@drawable/cm_bg_soft_blue" />
                        <TextView style="@style/QuickActionLabel" android:text="@string/generate_bills_label" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/cm_card"
            app:itemIconTint="@color/cm_nav_item_tint"
            app:itemTextColor="@color/cm_nav_item_tint"
            app:itemActiveIndicatorStyle="@null"
            app:itemIconSize="21dp"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu"
            app:elevation="0dp" />

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
