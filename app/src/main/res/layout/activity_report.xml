<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- ══════════════════════ HEADER BAR ══════════════════════ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:text="@string/financial_report"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFF"
        android:background="@color/cm_sidebar"
        android:gravity="center"
        android:letterSpacing="0.02" />

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/rowQuickPeriodFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <Button
                    android:id="@+id/btnToday"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/report_today"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button_ripple"
                    app:backgroundTint="@null" />
                <Button
                    android:id="@+id/btnYesterday"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/report_yesterday"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button_ripple"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- ══════════ MODE SELECTOR ROW ══════════ -->
            <LinearLayout
                android:id="@+id/rowMonthlyFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnMonthly"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="@string/monthly_report"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-light"
                    android:background="@drawable/bg_button_ripple"
                    app:backgroundTint="@null" />

            </LinearLayout>

            <!-- ══════════ DATE RANGE ROW ══════════ -->
            <LinearLayout
                android:id="@+id/rowDateRangeFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnStartDate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="@string/start_date"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-light"
                    android:background="@drawable/bg_button_ripple"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnEndDate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_height="44dp"
                    android:text="@string/end_date"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-light"
                    android:background="@drawable/bg_button_ripple"
                    app:backgroundTint="@null" />

            </LinearLayout>

            <!-- ══════════ EXPORT BUTTONS ══════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnExcel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="@string/export_csv"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-light"
                    android:background="@drawable/bg_button_ripple"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnPdf"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_height="44dp"
                    android:text="@string/export_pdf"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-light"
                    android:background="@drawable/bg_button_ripple"
                    app:backgroundTint="@null" />

            </LinearLayout>

            <!-- ══════════ SUMMARY CARD ══════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Dynamic report title -->
                    <TextView
                        android:id="@+id/tvReportTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/day_report"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/total_collected"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/cm_teal"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/payments_count"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvOutstanding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:visibility="gone"
                        android:layout_marginBottom="4dp" />

                    <!-- One row per payment mode present in this report's data -->
                    <LinearLayout
                        android:id="@+id/modeBreakdownContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════ PROGRESS ══════════ -->
            <ProgressBar
                android:id="@+id/progressBarReport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- ══════════ EMPTY STATE ══════════ -->
            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_payments_found"
                android:gravity="center"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:padding="32dp"
                android:visibility="gone" />

            <!-- ══════════ PAYMENTS LIST ══════════ -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvCollectorReportTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/collector_bill_report"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/collectorReportContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>